# EmotionHub 开发环境配置
# 请复制此文件为 .env 并填入您的配置

# 数据库配置
EMOTIONHUB_DB_HOST_DEV=localhost
EMOTIONHUB_DB_PORT_DEV=3306
EMOTIONHUB_DB_NAME_DEV=emotion_hub
EMOTIONHUB_DB_USERNAME_DEV=root
EMOTIONHUB_DB_PASSWORD_DEV=您的MySQL密码

# Redis配置
EMOTIONHUB_REDIS_HOST_DEV=localhost
EMOTIONHUB_REDIS_PORT_DEV=6379
EMOTIONHUB_REDIS_PASSWORD_DEV=

# 服务端口
EMOTIONHUB_SERVER_PORT_DEV=8082

# 阿里云 DashScope API Key
DASHSCOPE_API_KEY=您的API密钥
